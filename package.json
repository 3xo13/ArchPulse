{
  "name": "archpulse",
  "version": "0.1.0",
  "type": "module",
  "description": "ArchPulse — Bob IDE add-on for guided architecture violation repair",
  "private": true,
  "workspaces": [
    "demo/packages/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project src/viewer/tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "install:addon": "node scripts/install-bob-addon.js",
    "scan": "tsx src/cli/index.ts scan",
    "cases": "tsx src/cli/index.ts cases",
    "compare": "tsx src/cli/index.ts compare",
    "start": "tsx src/mcp/server.ts",
    "verify": "tsx src/cli/index.ts verify",
    "viewer:dev": "vite --config src/viewer/vite.config.ts",
    "viewer:build": "vite build --config src/viewer/vite.config.ts",
    "test:viewer": "npm run viewer:build && playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@viz-js/viz": "^3.30.0",
    "dependency-cruiser": "^16.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
